# Private deployment example. Copy values into your deployment secret manager;
# do not commit a populated .env file.
TASK_NOTIFICATIONS_ENABLED=true
PORT=4317
TASK_APP_BASE_URL=http://127.0.0.1:4317

# Slack Bot API: users:read.email, im:write, chat:write
SLACK_WORKSPACE_ID=T0BQ8BVE4Q4
SLACK_WORKSPACE_NAME=Aimadvisors
SLACK_WORKSPACE_DOMAIN=aimadvisors.slack.com
SLACK_BOT_TOKEN=

# Approved HTTPS endpoint that accepts the JSON task-alert contract in README.md
TASK_EMAIL_WEBHOOK_URL=

CAT_TASK_EMAIL=catherine@aimadvisors.ca
RICHARD_TASK_EMAIL=richardc@shellysbistro.com
VINCE_TASK_EMAIL=vince@shellysbistro.com

CAT_SLACK_EMAIL=catherine@aimadvisors.ca
RICHARD_SLACK_EMAIL=richardc@aimadvisors.ca
VINCE_SLACK_EMAIL=vince@shellysbistro.com

TASK_NOTIFICATION_CHANNELS_CAT=slack,email
TASK_NOTIFICATION_CHANNELS_RICHARD=slack,email
TASK_NOTIFICATION_CHANNELS_VINCE=slack,email

# Optional browser push configuration
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@shellysbistro.com

# Optional durable task/subscription storage directory
SHELLYS_DATA_DIR=
